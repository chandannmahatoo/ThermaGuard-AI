#!/bin/bash

set -e

PROJECT="/Users/chandankumarmahato/Desktop/SIH2026"
PY="$PROJECT/.venv/bin/python"

cd "$PROJECT"

EVENTS=(
  "TG-firms-17a1d9abb72d51592396|hazira_aug_2026"
  "TG-firms-4ee5757a7f0de593d158|hazira_aug_2026"
  "TG-firms-2cccb1d15213eca9a6c1|angul_talcher_aug_2026"
  "TG-firms-889ac864d33ccc099b73|chandrapur_aug_2026"
  "TG-firms-b21337d75f2e1696a2f7|chandrapur_aug_2026"
)

ALLOWED_LABELS=(
  "industrial_fire"
  "persistent_industrial_thermal_source"
  "agricultural_vegetation_fire"
  "natural_thermal_event"
  "possible_false_positive"
)

for ENTRY in "${EVENTS[@]}"; do

    EVENT_ID="${ENTRY%%|*}"
    SPLIT_GROUP="${ENTRY##*|}"

    echo
    echo "=================================================="
    echo "REVIEWING: $EVENT_ID"
    echo "SPLIT GROUP: $SPLIT_GROUP"
    echo "=================================================="

    PYTHONPATH=backend "$PY" \
      backend/prepare_review_row.py "$EVENT_ID"

    echo
    echo "Allowed labels:"
    for LABEL in "${ALLOWED_LABELS[@]}"; do
        echo "  - $LABEL"
    done

    echo
    read -r -p "Enter verified label, or type SKIP: " LABEL

    if [[ "$LABEL" == "SKIP" || "$LABEL" == "skip" ]]; then
        echo "Skipped $EVENT_ID"
        continue
    fi

    VALID=false
    for ALLOWED in "${ALLOWED_LABELS[@]}"; do
        if [[ "$LABEL" == "$ALLOWED" ]]; then
            VALID=true
            break
        fi
    done

    if [[ "$VALID" != true ]]; then
        echo "Invalid label. Event skipped."
        continue
    fi

    echo
    read -r -p "Enter REAL source/evidence reference: " SOURCE_REFERENCE

    if [[ -z "$SOURCE_REFERENCE" ]]; then
        echo "No source reference supplied. Event skipped."
        continue
    fi

    read -r -p "Confirm this review? Type YES: " CONFIRM

    if [[ "$CONFIRM" != "YES" ]]; then
        echo "Review not saved."
        continue
    fi

    PYTHONPATH=backend "$PY" \
      backend/prepare_review_row.py "$EVENT_ID" \
      --label "$LABEL" \
      --split-group "$SPLIT_GROUP" \
      --reviewer PRAGYAX_review \
      --source-reference "$SOURCE_REFERENCE" \
      --reviewed true

    echo "Saved review for $EVENT_ID"

done

echo
echo "=================================================="
echo "REVIEW PROGRESS"
echo "=================================================="

PYTHONPATH=backend "$PY" backend/review_progress.py

echo
echo "=================================================="
echo "VALIDATION"
echo "=================================================="

PYTHONPATH=backend "$PY" backend/validate_review_candidates.py || true

