# ThermaGuard AI frontend API configuration.
# Copy to .env.local and adjust for your environment.
# These are build-time variables: restart `npm run dev` / rebuild after changing them.

# Base URL for all authenticated API calls (single source of truth; lib/api.ts).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Backend origin, used for the unauthenticated GET /health check.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
