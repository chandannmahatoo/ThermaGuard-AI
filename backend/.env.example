# =========================================================
# THERMAGUARD AI - BACKEND ENVIRONMENT
# =========================================================

# Fill credential placeholders before enabling Gemini/SMTP or real mode.

# ---------------------------------------------------------
# DATABASE
# ---------------------------------------------------------
DATABASE_URL=sqlite:///./thermaguard.db

# ---------------------------------------------------------
# APPLICATION MODE
# ---------------------------------------------------------
DEMO_MODE=true

# ---------------------------------------------------------
# AUTH / JWT
# ---------------------------------------------------------
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# ---------------------------------------------------------
# NASA FIRMS
# ---------------------------------------------------------
FIRMS_MAP_KEY=
FIRMS_API_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv
FIRMS_AVAILABILITY_URL=https://firms.modaps.eosdis.nasa.gov/api/data_availability/csv
FIRMS_LIVE_SOURCES=VIIRS_NOAA21_NRT,VIIRS_NOAA20_NRT,VIIRS_SNPP_NRT,MODIS_NRT
FIRMS_MAX_REQUESTS=12
FIRMS_TIMEOUT_SECONDS=30
MAX_SYNC_OBSERVATIONS=500

# ---------------------------------------------------------
# EVENT CLUSTERING
# ---------------------------------------------------------
EVENT_CLUSTER_RADIUS_KM=2
EVENT_CLUSTER_TIME_HOURS=24

# ---------------------------------------------------------
# OPENSTREETMAP / OVERPASS
# ---------------------------------------------------------
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OSM_TIMEOUT_SECONDS=20
OSM_EVENTS_PER_SYNC=5

# ---------------------------------------------------------
# COPERNICUS DATA SPACE / SENTINEL HUB
# ---------------------------------------------------------
SATELLITE_PROVIDER=copernicus
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_BASE_URL=https://sh.dataspace.copernicus.eu
COPERNICUS_TOKEN_TIMEOUT_SECONDS=15
COPERNICUS_STATS_TIMEOUT_SECONDS=20
SATELLITE_EVENTS_PER_SYNC=5

# ---------------------------------------------------------
# GOOGLE GEMINI AI COPILOT
# ---------------------------------------------------------
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=30

# ---------------------------------------------------------
# SMTP EMAIL NOTIFICATIONS
# ---------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=20

# ---------------------------------------------------------
# ALERT SYSTEM
# ---------------------------------------------------------
AUTO_ALERT_RISK_THRESHOLD=80
DEFAULT_ALERT_RADIUS_KM=10

# ---------------------------------------------------------
# RISK SCORING
# ---------------------------------------------------------
RISK_WEIGHTS={"thermal_severity":50,"persistence":10,"industrial_proximity":10,"residential_proximity":10,"infrastructure_exposure":5,"classification_context":5,"historical_abnormality":10}

# ---------------------------------------------------------
# CORS
# ---------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------
# WEATHER
# ---------------------------------------------------------
WEATHER_ENABLED=true
WEATHER_PROVIDER=open_meteo
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=15
WEATHER_EVENTS_PER_SYNC=10

# ---------------------------------------------------------
# AIR QUALITY
# ---------------------------------------------------------
AIR_QUALITY_ENABLED=true
AIR_QUALITY_PROVIDER=open_meteo
AIR_QUALITY_API_URL=https://air-quality-api.open-meteo.com/v1/air-quality
AIR_QUALITY_TIMEOUT_SECONDS=15
AIR_QUALITY_EVENTS_PER_SYNC=10

# ---------------------------------------------------------
# REVERSE GEOCODING
# ---------------------------------------------------------
GEOCODING_ENABLED=true
GEOCODING_PROVIDER=nominatim
GEOCODING_API_URL=https://nominatim.openstreetmap.org/reverse
GEOCODING_TIMEOUT_SECONDS=10
GEOCODING_EVENTS_PER_SYNC=10
GEOCODING_USER_AGENT=ThermaGuardAI/1.0

# ---------------------------------------------------------
# NASA EONET
# ---------------------------------------------------------
EONET_ENABLED=true
EONET_API_URL=https://eonet.gsfc.nasa.gov/api/v3/events
EONET_TIMEOUT_SECONDS=15
EONET_EVENTS_PER_SYNC=10

# ---------------------------------------------------------
# OPTIONAL ROUTING
# ---------------------------------------------------------
ROUTING_ENABLED=true
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_API_URL=https://api.openrouteservice.org
ROUTING_TIMEOUT_SECONDS=15

# ---------------------------------------------------------
# OPTIONAL FIREBASE
# ---------------------------------------------------------
PUSH_NOTIFICATIONS_ENABLED=true
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
